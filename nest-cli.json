{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/tubodega/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/tubodega/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/tubodega",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "tubodega": {
      "type": "application",
      "root": "apps/tubodega",
      "entryFile": "main",
      "sourceRoot": "apps/tubodega/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tubodega/tsconfig.app.json"
      }
    },
    "persistence": {
      "type": "library",
      "root": "libs/persistence",
      "entryFile": "index",
      "sourceRoot": "libs/persistence/src",
      "compilerOptions": {
        "tsConfigPath": "libs/persistence/tsconfig.lib.json"
      }
    },
    "tenancy": {
      "type": "library",
      "root": "libs/tenancy",
      "entryFile": "index",
      "sourceRoot": "libs/tenancy/src",
      "compilerOptions": {
        "tsConfigPath": "libs/tenancy/tsconfig.lib.json"
      }
    },
    "catalog": {
      "type": "library",
      "root": "libs/catalog",
      "entryFile": "index",
      "sourceRoot": "libs/catalog/src",
      "compilerOptions": {
        "tsConfigPath": "libs/catalog/tsconfig.lib.json"
      }
    },
    "inventory": {
      "type": "library",
      "root": "libs/inventory",
      "entryFile": "index",
      "sourceRoot": "libs/inventory/src",
      "compilerOptions": {
        "tsConfigPath": "libs/inventory/tsconfig.lib.json"
      }
    },
    "process": {
      "type": "library",
      "root": "libs/process",
      "entryFile": "index",
      "sourceRoot": "libs/process/src",
      "compilerOptions": {
        "tsConfigPath": "libs/process/tsconfig.lib.json"
      }
    }
  }
}
