  "info": {
    "title": "tubodega",
    "description": "WMS de movimientos: contrato público v1",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OwnerDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "marta@esquina.co"
          },
          "name": {
            "type": "string",
            "example": "Marta"
          },
          "password": {
            "type": "string",
            "example": "correcthorse1",
            "minLength": 10
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Distribuidora La Esquina"
          },
          "slug": {
            "type": "string",
            "example": "la-esquina",
            "description": "minúsculas, dígitos y guiones, 3-64"
          },
          "owner": {
            "$ref": "#/components/schemas/OwnerDto"
          }
        },
        "required": [
          "name",
          "slug",
          "owner"
        ]
      },
      "OrganizationView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "018f3a2b-7c4d-7000-8000-a1b2c3d4e5f6"
          },
          "name": {
            "type": "string",
            "example": "Distribuidora La Esquina"
          },
          "slug": {
            "type": "string",
            "example": "la-esquina"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "UserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "018f3a2b-7c4d-7000-8000-a1b2c3d4e5f7"
          },
          "email": {
            "type": "string",
            "example": "marta@esquina.co"
          },
          "name": {
            "type": "string",
            "example": "Marta"
          },
          "roles": {
            "type": "array",
            "example": [
              "OWNER"
            ],
            "items": {
              "type": "string",
              "enum": [
                "OWNER",
                "ADMIN",
                "OPERATOR",
                "VIEWER"
              ]
            }
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "roles",
          "active"
        ]
      },
      "OrganizationCreatedView": {
        "type": "object",
        "properties": {
          "organization": {
            "$ref": "#/components/schemas/OrganizationView"
          },
          "owner": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "required": [
          "organization",
          "owner"
        ]
      },
      "ProblemDetailsView": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://tubodega.app/errors/slug-taken"
          },
          "title": {
            "type": "string",
            "example": "Conflicto"
          },
          "status": {
            "type": "number",
            "example": 409
          },
          "detail": {
            "type": "string",
            "example": "El slug \"la-esquina\" ya está en uso"
          },
          "instance": {
            "type": "string",
            "example": "/v1/organizations"
          },
          "traceId": {
            "type": "string",
            "example": "018f3a2b-7c4d-7000-8000-a1b2c3d4e5f6"
          },
          "errors": {
            "example": [
              {
                "pointer": "/slug",
                "code": "isLength"
              }
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "traceId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "marta@esquina.co"
          },
          "password": {
            "type": "string",
            "example": "correcthorse1"
          },
          "slug": {
            "type": "string",
            "example": "la-esquina",
            "description": "Obligatorio si el correo existe en varias organizaciones"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPairView": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiJ9…"
          },
          "refreshToken": {
            "type": "string",
            "example": "k3JgQ…",
            "description": "Opaco; se rota en cada uso"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Segundos de validez del accessToken"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "k3JgQ…"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenRotationView": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiJ9…"
          },
          "refreshToken": {
            "type": "string",
            "example": "k3JgQ…",
            "description": "Nuevo; el anterior queda revocado"
          },
          "expiresIn": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "PageView": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "string",
            "example": "W3siYSI6MX1d",
            "description": "Opaco: se devuelve tal cual en `cursor`"
          },
          "hasMore": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "hasMore"
        ]
      },
      "UserPageView": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserView"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageView"
          }
        },
        "required": [
          "data",
          "page"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "juan@esquina.co"
          },
          "name": {
            "type": "string",
            "example": "Juan"
          },
          "password": {
            "type": "string",
            "example": "correcthorse1",
            "minLength": 10
          },
          "roles": {
            "type": "array",
            "example": [
              "OPERATOR"
            ],
            "items": {
              "type": "string",
              "enum": [
                "OWNER",
                "ADMIN",
                "OPERATOR",
                "VIEWER"
              ]
            }
          }
        },
        "required": [
          "email",
          "name",
          "password",
          "roles"
        ]
      },
      "UpdateUserRolesDto": {
        "type": "object",
