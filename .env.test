# Test-only values. Loaded by vitest (test/support/env.ts) for pnpm test:e2e.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://tubodega_app:app@localhost:5432/tubodega_test
DATABASE_URL_SYSTEM=postgresql://tubodega_system:system@localhost:5432/tubodega_test
DATABASE_URL_MIGRATOR=postgresql://tubodega_migrator:migrator@localhost:5432/tubodega_test
SHADOW_DATABASE_URL=postgresql://tubodega_migrator:migrator@localhost:5432/tubodega_shadow
DATABASE_POOL_SIZE=5
JWT_SECRET=test-secret-test-secret-test-secret-0123
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Where product photos land: MEDIA_ROOT/<orgId>/<key>
MEDIA_ROOT=.media-test

# How often the outbox dispatcher runs (ms). Not started under NODE_ENV=test.
OUTBOX_INTERVAL_MS=1000
