// Single source of truth of the schema (docs/specs/04). Prisma is a
// development and deployment dependency only: it defines the model and
// controls its changes. Kysely is what runs, on the types generated here.

generator kysely {
  provider        = "prisma-kysely"
  output          = "../src/generated"
  fileName        = "db.ts"
  camelCase       = true
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider          = "postgresql"
  extensions        = [citext]
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  VIEWER

  @@map("role_enum")
}

/// The tenant. The only business table without org_id and without RLS (spec 10 §6).
model Organization {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique @db.VarChar(64)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version   Int      @default(1)
  users     AppUser[]

  @@map("organization")
}

model AppUser {
  id           String   @id @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  email        String   @db.Citext
  passwordHash String   @map("password_hash")
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  version      Int      @default(1)

  organization Organization   @relation(fields: [orgId], references: [id])
  roles        UserRole[]
  sessions     RefreshToken[]

  @@unique([orgId, email])
  @@unique([orgId, id])
  @@map("app_user")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  orgId  String @map("org_id") @db.Uuid
  role   Role

  user AppUser @relation(fields: [orgId, userId], references: [orgId, id])

  @@id([userId, role])
  @@map("user_role")
}

/// Refresh sessions: opaque token stored by SHA-256 hash, rotated on use, revoked on logout (spec 10 §4).
model RefreshToken {
  id        String    @id @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user AppUser @relation(fields: [orgId, userId], references: [orgId, id])

  // Partial (WHERE revoked_at IS NULL); the predicate is added by hand in the migration.
  @@index([userId])
  @@map("refresh_token")
}

/// Transactional outbox (spec 05 §2): the event exists iff the fact happened.
model OutboxEvent {
  id          String    @id @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  type        String    @db.VarChar(64)
  payload     Json
  traceId     String    @map("trace_id") @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  // Partial (WHERE published_at IS NULL); predicate added by hand in the migration.
  @@index([publishedAt, occurredAt])
  @@map("outbox_event")
}
