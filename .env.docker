# Entorno del `docker compose up` local. Versionado a propósito: aquí no hay
# ningún secreto real, solo los valores que hacen arrancar la pila entera dentro
# de la red de compose. Lo lee `env_file:` en compose.yaml; la aplicación no lo
# abre nunca —ConfigModule no declara `envFilePath`— y valida lo que ya está en
# el entorno del contenedor (libs/common/src/config/env.validation.ts).
#
# Es .env.example con tres diferencias, y solo tres:
#   1. el host de Postgres es `db`, el nombre del servicio en la red de compose;
#      `localhost` dentro del contenedor es el contenedor mismo;
#   2. la base es `tubodega_docker`, propia de la pila: así los datos y las fotos
#      del contenedor viajan juntos y `docker compose down -v` no toca la base de
#      desarrollo;
#   3. MEDIA_ROOT es absoluta y apunta a donde compose monta el volumen `media`.

NODE_ENV=production
PORT=3000

# Tres cadenas, tres roles de Postgres (spec 07 §2, 04 §4). Los roles y la base
# los crea db/init/01-roles.sql al inicializarse el volumen dbdata.
DATABASE_URL=postgresql://tubodega_app:app@db:5432/tubodega_docker
DATABASE_URL_SYSTEM=postgresql://tubodega_system:system@db:5432/tubodega_docker
DATABASE_URL_MIGRATOR=postgresql://tubodega_migrator:migrator@db:5432/tubodega_docker
DATABASE_POOL_SIZE=10

# Sin SHADOW_DATABASE_URL: es @IsOptional() y solo la usan `prisma migrate dev` y
# `pnpm db:check`. `migrate deploy` no la mira; el job blackbox de CI corre sin
# ella desde siempre.

# 38 caracteres, por encima del @MinLength(32). Dice lo que es.
JWT_SECRET=docker-compose-local-only-not-a-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Absoluta, y fuera de la raíz de /app: /app lo creó root con WORKDIR y el
# proceso corre como `node`. El Dockerfile crea este directorio y se lo cede a
# `node` antes de USER node; compose monta encima el volumen `media`.
MEDIA_ROOT=/app/media

OUTBOX_INTERVAL_MS=1000
