# Copy to .env for local runs. Every value is validated at boot by
# libs/common/src/config/env.validation.ts — an invalid value aborts startup.

# one of: development | production | test
NODE_ENV=development
# 1-65535
PORT=3000

# Three connection strings, three Postgres roles (spec 07 §2, 04 §4):
DATABASE_URL=postgresql://tubodega_app:app@localhost:5432/tubodega
DATABASE_URL_SYSTEM=postgresql://tubodega_system:system@localhost:5432/tubodega
DATABASE_URL_MIGRATOR=postgresql://tubodega_migrator:migrator@localhost:5432/tubodega
# development and CI only: shadow database for `prisma migrate dev` and `pnpm db:check`
SHADOW_DATABASE_URL=postgresql://tubodega_migrator:migrator@localhost:5432/tubodega_shadow
DATABASE_POOL_SIZE=10

# HS256 signing secret, at least 32 characters
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Where product photos land: MEDIA_ROOT/<orgId>/<key>
MEDIA_ROOT=.media

# How often the outbox dispatcher runs (ms). Not started under NODE_ENV=test.
OUTBOX_INTERVAL_MS=1000
