    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "packageManager": "pnpm@12.3.4"
