{
  "name": "tubodega",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build tubodega",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start tubodega",
    "start:dev": "nest start tubodega --watch",
    "start:debug": "nest start tubodega --debug --watch",
    "start:prod": "node dist/apps/tubodega/main",
    "lint": "oxlint apps/ libs/ test/ && depcruise apps libs --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma migrate diff --from-migrations libs/persistence/prisma/migrations --to-schema libs/persistence/prisma/schema.prisma --exit-code",
    "openapi:write": "UPDATE_OPENAPI=1 vitest run --config ./vitest.config.e2e.ts apps/tubodega/test/edge/openapi.int-spec.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@node-rs/argon2": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.12.1",
    "jose": "^6.2.12",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "prisma-kysely": "^3.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
